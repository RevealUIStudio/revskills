{
  "$schema_note": "Default knobs for redundancy-scan. Override via --config path. Do not put private repo paths here.",
  "excludeDirNames": [
    "node_modules",
    ".git",
    "dist",
    "build",
    ".next",
    "coverage",
    ".turbo",
    "opensrc",
    ".direnv",
    "target",
    "vendor",
    "playwright-report",
    "test-results",
    "e2e-results",
    "accessibility-results",
    "visual-results",
    ".pgdata",
    ".playwright-mcp",
    "result",
    "archive"
  ],
  "textExtensions": [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs",
    ".json",
    ".jsonc",
    ".yml",
    ".yaml",
    ".toml",
    ".md",
    ".mdx",
    ".css",
    ".scss",
    ".sql",
    ".rs",
    ".go",
    ".py",
    ".sh",
    ".ps1",
    ".html",
    ".svg"
  ],
  "deprecationSubstrings": [
    "@deprecated",
    "DEPRECATED",
    "deprecated —",
    "deprecated -",
    "superseded by",
    "SUPERSEDED",
    "do not use",
    "DO NOT USE",
    "retired path",
    "legacy fallback",
    "remove in follow-up",
    "TODO: delete",
    "TODO: remove",
    "FIXME: remove",
    "FIXME: delete",
    "obsolete",
    "no longer used"
  ],
  "redundancySubstrings": [
    "keep in lockstep",
    "duplicate of",
    "copied from",
    "mirrors ",
    "same as ",
    "byte-identical",
    "intentional dual",
    "do not reimplement",
    "parallel implementation",
    "shadow library",
    "near-identical"
  ],
  "minHashBytes": 8,
  "maxFileBytes": 1500000
}
