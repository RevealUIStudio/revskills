#!/usr/bin/env bash
# .githooks/pre-push — runs all revskills validators before push.
#
# Activates via:  git config core.hooksPath .githooks
# (run once after clone; a chicken-and-egg situation prevents auto-install)
#
# Runs scanners in order, fails fast:
#   1. lint-all-skills.sh        — frontmatter, awk rules, broken symlinks
#   2. lint-plugins.sh .         — in-repo plugin metadata (Claude plugin = adapter)
#   3. check-no-private-leaks.sh — private-path leak scan (repo-wide)
#   4. md-truth-check --self-test — GAP-407 W6 MD-truth program health
#
# Override with SKIP_PREPUSH=1 git push  (use only when you know why).

set -uo pipefail

if [[ -n "${SKIP_PREPUSH:-}" ]]; then
  echo "[pre-push] SKIP_PREPUSH set — bypassing validators." >&2
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

fail=0
run_check() {
  local name="$1"
  shift
  echo "[pre-push] $name …" >&2
  if ! "$@"; then
    echo "[pre-push] $name FAILED" >&2
    fail=1
  fi
}

run_check "skills-lint"          bash "$REPO_ROOT/scripts/lint-all-skills.sh"
run_check "plugin-lint"          bash "$REPO_ROOT/scripts/lint-plugins.sh" .
run_check "private-leak-scan"    bash "$REPO_ROOT/scripts/check-no-private-leaks.sh"
run_check "md-truth-self-test"   node "$REPO_ROOT/skills/exhaustive-audit/scripts/md-truth-check.js" --self-test

if (( fail )); then
  echo "[pre-push] ONE OR MORE VALIDATORS FAILED — push blocked." >&2
  echo "[pre-push] Fix the issues above, or bypass with: SKIP_PREPUSH=1 git push (document why in the PR)." >&2
  exit 1
fi

echo "[pre-push] all validators passed." >&2
exit 0
